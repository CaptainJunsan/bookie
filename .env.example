# Bookie environment variables
# Copy this file to .env.local and fill in the values

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Base URL used in all share cards, invite links, QR codes and handover letters.
# Change this once when the official domain is registered — every link updates automatically.
# Do NOT include a trailing slash.
VITE_APP_URL=https://bookie-seven-pi.vercel.app

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable the in-app Book Dash reader and catalogue.
# Only enable once the Book Dash partnership is confirmed (PRD §7.1).
VITE_BOOK_DASH_ENABLED=false
